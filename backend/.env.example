SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
# Shared model for knowledge extraction and tool comparisons.
ANTHROPIC_MODEL=claude-sonnet-4-6
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=

# inline (existing Railway behavior) or github_actions (persist the queue only).
# Switch only after configuring and dry-running the GitHub Actions worker.
PROCESSING_MODE=inline

# Base64 of a Netscape-format Instagram cookies file; optional for public content.
# Keep the value in Railway/GitHub secrets. Never commit cookies or paste them in chat.
INSTAGRAM_COOKIES_B64=

# Private Telegram Q&A. Empty means nobody may read knowledge or submit Reels.
# Send /start to your bot to see your own numeric user ID, then allow that ID.
TELEGRAM_ALLOWED_USER_IDS=
# Optional frontend origin for Library citations; otherwise link to source Reels.
PUBLIC_APP_URL=
